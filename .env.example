# ---------------------------------------------------------------------------
# La Dolce Vita - environment variables
#
# Copy this file to `.env.local` and fill in the real values. `.env.local` is
# gitignored and must never be committed.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle, so only put values
# there that are public by design. The variables below the divider have no
# NEXT_PUBLIC_ prefix and are therefore server-only: they are read exclusively by
# Server Actions and Server Components and never reach the client.
#
# There is deliberately NO service-role or secret key. The public site performs
# read-only queries through Row Level Security, which is the security boundary.
# A secret key would bypass RLS entirely and must never reach this file.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Public by design: it resolves to
# the `anon` Postgres role, so RLS decides what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin of the deployed site, e.g. https://example.com
# Used for metadataBase, canonical URLs, and hreflang alternates. When unset,
# the site falls back to the Vercel-injected URL and then to localhost.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Server-only configuration. No NEXT_PUBLIC_ prefix, so none of this is bundled
# for the browser. Bucket names are configuration for server-side writes.
# ---------------------------------------------------------------------------

# Storage bucket for section images. Leave empty to disable section image
# uploads; the rest of the Sections form continues to work.
SUPABASE_SECTIONS_BUCKET=

# Storage bucket for menu-item images. The project already has a `menu-images`
# bucket, and menu-item objects are written under a `menu-items/<id>/` prefix
# inside it. Leave empty to disable menu-item image uploads; the rest of the
# Menu Items form continues to work.
SUPABASE_MENU_ITEMS_BUCKET=menu-images

# Currencies the Menu Items form may write to `menu_items.currency`, comma
# separated and in the order they should appear, e.g. `IQD,USD`.
#
# The column is typed `text` with a database default and the generated types
# carry no CHECK constraint, so the accepted set is not discoverable from the
# schema. Values are used verbatim - they must match whatever the database
# constraint spells, exactly.
#
# WHEN EMPTY the currency control is hidden and the column is not written at
# all, so the database default applies. That is deliberate: omitting a column
# with a default always succeeds, whereas writing an unverified code might never
# succeed.
MENU_ITEM_CURRENCIES=USD,EUR,SYP
