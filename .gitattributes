# Normalize all text files to LF in the repository and on checkout.
# The project is developed on Windows but built and hosted on Linux (Vercel),
# so LF everywhere avoids phantom diffs and Prettier --check failures in CI.
* text=auto eol=lf

# Explicit text types
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.css      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.svg      text eol=lf
*.html     text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.nvmrc     text eol=lf

# Binary assets: never diff, never normalize
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.avif     binary
*.ico      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.pdf      binary
*.mp4      binary
*.webm     binary

# Generated files: keep them out of diffs and language stats
package-lock.json -diff linguist-generated=true
