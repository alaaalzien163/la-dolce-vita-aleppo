# --- Dependencies ---
node_modules/
.pnp
.pnp.*

# --- Next.js build output ---
.next/
out/
build/
dist/

# --- Testing / coverage ---
coverage/

# --- TypeScript ---
*.tsbuildinfo
# Generated by Next.js. It hard-imports .next/types/*.d.ts (build artifacts),
# so committing it would break `tsc` on a fresh clone. The `typecheck` script
# runs `next typegen` first to regenerate both.
next-env.d.ts

# --- Environment variables (never commit real values) ---
.env
.env.*
!.env.example

# --- Vercel ---
.vercel

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
