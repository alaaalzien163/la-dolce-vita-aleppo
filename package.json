{
  "name": "la-dolce-vita",
  "version": "0.1.0",
  "private": true,
  "description": "La Dolce Vita - restaurant & cafe website (Next.js App Router, Arabic RTL / English LTR)",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-app-icon.mjs",
    "db:inspect": "node --env-file-if-exists=.env.local scripts/inspect-schema.mjs",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/lib/supabase/database.types.ts",
    "db:types:win": "supabase gen types typescript --project-id %SUPABASE_PROJECT_ID% --schema public > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "clsx": "2.1.1",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
